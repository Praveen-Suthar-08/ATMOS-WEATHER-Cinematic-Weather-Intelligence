# Atmos Weather — security headers (Netlify / Cloudflare Pages)
# Static, frontend-only app: no cookies, no auth, no server-side sessions.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tilecache.rainviewer.com; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://air-quality-api.open-meteo.com https://archive-api.open-meteo.com https://customer-api.open-meteo.com https://customer-geocoding-api.open-meteo.com https://customer-air-quality-api.open-meteo.com https://api.rainviewer.com https://tilecache.rainviewer.com https://api.bigdatacloud.net https://nominatim.openstreetmap.org; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Long-lived immutable caching for fingerprinted/static assets (CDN scale)
/images/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
